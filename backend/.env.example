# Copie para backend/.env (nunca versionado) e ajuste. Variáveis de ambiente reais têm prioridade sobre este arquivo.

# --- Banco de dados -------------------------------------------------------
# Se DB_URL não for informado, um PostgreSQL embarcado é iniciado automaticamente
# com os dados persistidos em backend/data/pg (ideal para a demonstração).
DB_URL=
DB_USER=
DB_PASSWORD=
#
# Supabase (em espera / standby): descomente as 3 linhas abaixo e preencha para usar o banco na nuvem.
# Enquanto estiverem comentadas, a aplicação usa o PostgreSQL embarcado local.
# Use o "Session pooler" (porta 5432) ou a conexão direta; ambos exigem sslmode=require.
#DB_URL=jdbc:postgresql://aws-0-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require
#DB_USER=postgres.<ref-do-projeto>
#DB_PASSWORD=<senha-do-banco>
# No plano gratuito do Supabase, limite o pool:
#DB_POOL_SIZE=5
# Tamanho do pool de conexões (Supabase free: use 5)
DB_POOL_SIZE=10
# Porta do PostgreSQL embarcado (somente quando DB_URL está vazio)
APP_EMBEDDED_DB_PORT=54329

# --- Servidor -------------------------------------------------------------
PORT=8080
# Diretório de dados locais (PostgreSQL embarcado e chave JWT gerada)
APP_DATA_DIR=./data
# Origens permitidas para CORS, separadas por vírgula. Vazio = CORS desabilitado (mesma origem via proxy do Vite).
APP_CORS_ORIGINS=
# Atrás de um proxy reverso (Render, Railway, Nginx) use "native" para respeitar X-Forwarded-*.
APP_FORWARD_HEADERS=none

# --- Segurança ------------------------------------------------------------
# Segredo do JWT (HS256), mínimo 32 bytes. Gere com: openssl rand -base64 48
# Se vazio, um segredo aleatório é gerado e salvo em data/jwt-secret.key.
APP_JWT_SECRET=
# Cookies com atributo Secure: auto (somente quando a requisição chega por HTTPS), true ou false
APP_COOKIE_SECURE=auto
# Janela de tolerância (segundos) para reuso do refresh token em requisições simultâneas. 0 = detecção estrita.
APP_REFRESH_GRACE_SECONDS=0
# Chave HMAC-SHA256 da cadeia de integridade (extrato de pontos e auditoria), mínimo 32 bytes.
# Gere com: openssl rand -base64 48. Se vazio, uma chave aleatória é gerada e salva em data/integrity.key.
# Guarde-a FORA do banco e não a troque depois de criado o banco (as linhas antigas deixariam de verificar).
APP_INTEGRITY_KEY=

# --- Regras de negócio ----------------------------------------------------
# Cria dados de demonstração quando o banco não tem usuários
APP_DEMO_SEED=true
# Aprova automaticamente descartes pequenos e de baixo risco (padrão: desligado)
APP_AUTO_APPROVE=false
# Pontuação de risco (0-100) a partir da qual o descarte é sinalizado para revisão
APP_FRAUD_THRESHOLD=50

# --- IoT ------------------------------------------------------------------
# Simulador que aumenta gradualmente o nível das lixeiras de demonstração
APP_IOT_SIMULATOR=true
APP_IOT_SIMULATOR_INTERVAL=90s
# Horas sem leitura para considerar a lixeira OFFLINE
APP_IOT_OFFLINE_HOURS=6

# --- IA (classificação de resíduos por foto) ------------------------------
# Sem chave, a IA do servidor fica indisponível e o front-end usa o modelo local no navegador.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
